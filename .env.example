# Service Maestro container environment
# Copy to .env next to compose.yaml (the file is gitignored).

WLM_ADMIN_PASSWORD=change-me
WLM_OUTPUT_TOKEN=dev-output

# ChurchSuite Planning API
# Put the API-enabled user's OAuth client credentials here, then restart:
#   docker compose up -d --build
# The Config page can test the connection.
WLM_CHURCHSUITE_CLIENT_ID=
WLM_CHURCHSUITE_CLIENT_SECRET=
WLM_CHURCHSUITE_TOKEN_URL=https://login.churchsuite.com/oauth2/token
WLM_CHURCHSUITE_SCOPES=planning.read
WLM_CHURCHSUITE_API_URL=https://api.churchsuite.com/v2
# Optional for the authorization-code flow (not used by client credentials):
# WLM_CHURCHSUITE_REDIRECT_URI=

# Optional overrides
# WLM_FONTS_DIR=/data/fonts

# Service Maestro container environment
# Copy to .env next to compose.yaml (the file is gitignored).

SM_ADMIN_PASSWORD=change-me
SM_OUTPUT_TOKEN=dev-output

# ChurchSuite Planning API
# Put the API-enabled user's OAuth client credentials here, then restart:
#   docker compose up -d --build
# The Config page can test the connection.
SM_CHURCHSUITE_CLIENT_ID=
SM_CHURCHSUITE_CLIENT_SECRET=
SM_CHURCHSUITE_TOKEN_URL=https://login.churchsuite.com/oauth2/token
SM_CHURCHSUITE_SCOPES=planning.read
SM_CHURCHSUITE_API_URL=https://api.churchsuite.com/v2
# Optional for the authorization-code flow (not used by client credentials):
# SM_CHURCHSUITE_REDIRECT_URI=

# Optional overrides
# SM_FONTS_DIR=/data/fonts
# SM_IMAGES_DIR=/library/images

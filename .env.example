# Service Maestro container environment
# Copy to .env next to compose.yaml (the file is gitignored).

SM_ADMIN_PASSWORD=change-me
SM_OUTPUT_TOKEN=dev-output

# Optional YAML/JSON config file (environment values above still win).
# Mount it into the container and uncomment the volume in compose.yaml.
# SM_CONFIG_FILE=/config/config.yaml

# ChurchSuite Planning API
# Put the API-enabled user's OAuth client credentials here, then restart:
#   docker compose up -d --build
# The Config page can test the connection.
SM_CHURCHSUITE_CLIENT_ID=
SM_CHURCHSUITE_CLIENT_SECRET=
SM_CHURCHSUITE_TOKEN_URL=https://login.churchsuite.com/oauth2/token
SM_CHURCHSUITE_SCOPES=planning.read
SM_CHURCHSUITE_API_URL=https://api.churchsuite.com/v2
# Optional for the authorization-code flow (not used by client credentials):
# SM_CHURCHSUITE_REDIRECT_URI=

# Listener ports (inside the container). The control port is HTTPS-only;
# the display port stays plain HTTP for OBS/display devices.
SM_PORT=8080
SM_DISPLAY_PORT=8081

# Control HTTPS certificate. Defaults to /data/ssl/cert.pem and key.pem.
# If neither file exists, a local self-signed certificate is generated.
# SM_SSL_DIR=/data/ssl
# SM_SSL_CERT_FILE=
# SM_SSL_KEY_FILE=
# Extra DNS names/IPs for the generated certificate, comma-separated.
# SM_SSL_HOSTS=service-maestro.local,192.168.1.20

# Optional overrides
# SM_FONTS_DIR=/data/fonts
# SM_IMAGES_DIR=/library/images

# Git data repositories (songs and set lists are the important ones).
# Leave a remote empty to keep that repository local-only.
SM_GIT_ENABLED=true
SM_GIT_AUTO_SAVE=true
SM_GIT_AUTO_PUSH=true
SM_GIT_PULL_INTERVAL=60
SM_GIT_SONGS_REMOTE=
SM_GIT_SONGS_REMOTE_BRANCH=main
SM_GIT_SETLISTS_REMOTE=
SM_GIT_SETLIST_REMOTE_BRANCH=main
# SM_GIT_BIBLES_REMOTE=
# SM_GIT_BIBLES_REMOTE_BRANCH=main
# SM_GIT_TEMPLATES_REMOTE=
# SM_GIT_TEMPLATES_REMOTE_BRANCH=main

# CCLI SongSelect watched import folder
# Point the CCLI downloader's output folder at this path (or bind-mount it).
# SM_SONGSELECT_WATCH_DIR=/data/imports/songselect
# SM_SONGSELECT_WATCH_ENABLED=true
# SM_SONGSELECT_WATCH_INTERVAL=10

[Unit]
Description=Service Maestro
Documentation=file:/usr/share/doc/service-maestro-server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=service-maestro
Group=service-maestro
WorkingDirectory=/usr/lib/service-maestro/app
EnvironmentFile=/etc/service-maestro/service-maestro.env
ExecStart=/usr/lib/service-maestro/runtime/node /usr/lib/service-maestro/app/packages/server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/service-maestro
UMask=0027

[Install]
WantedBy=multi-user.target

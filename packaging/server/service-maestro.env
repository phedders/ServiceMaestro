# Service Maestro server environment.
# After changing this file run: systemctl restart service-maestro.service

SM_HOST=0.0.0.0
SM_PORT=8080
SM_DISPLAY_PORT=8081

SM_DATA_DIR=/var/lib/service-maestro/data
SM_IMAGES_DIR=/var/lib/service-maestro/library/images
SM_SONGS_DIR=/var/lib/service-maestro/library/songs
SM_BIBLE_DIR=/var/lib/service-maestro/library/bible
SM_SONGSELECT_WATCH_DIR=/var/lib/service-maestro/imports/songselect

SM_SSL_ENABLED=true
SM_SSL_DIR=/var/lib/service-maestro/ssl
SM_CONFIG_FILE=/etc/service-maestro/config.yaml

SM_ADMIN_PASSWORD_FILE=/etc/service-maestro/admin-password
SM_OUTPUT_TOKEN_FILE=/etc/service-maestro/output-token

SM_GIT_ENABLED=true
SM_LOG_LEVEL=info
